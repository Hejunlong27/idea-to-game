{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Hejunlong27/idea-to-game/references/schemas/creative-dna.schema.json",
  "title": "Creative DNA — 一款游戏的统一创意身份",
  "description": "贯穿全部生产环节的单一身份真相源。玩法/叙事/视觉/音频/体验五个域都必须引用它，禁止各自发挥。所有 *_identity / *_promise / signature_* 字段是「可判定」的：不得写成形容词堆砌。",
  "type": "object",
  "required": ["version", "meta", "identity", "gameplay", "narrative", "visual", "audio", "experience"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "const": "3.0" },
    "meta": {
      "type": "object",
      "required": ["idea", "concept_id", "created", "judged_by"],
      "additionalProperties": true,
      "properties": {
        "idea": { "type": "string", "minLength": 4 },
        "concept_id": { "type": "string", "pattern": "^C[1-9][0-9]*$" },
        "created": { "type": "string", "minLength": 10 },
        "judged_by": { "type": "string" },
        "creative_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "novelty_note": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["game_title", "core_fantasy", "unique_hook", "creative_promise", "signature_moment"],
      "additionalProperties": true,
      "properties": {
        "game_title": { "type": "string", "minLength": 2, "maxLength": 40 },
        "core_fantasy": {
          "type": "string", "minLength": 12,
          "description": "玩家想成为谁/想体验什么。必须写「我……」的第一人称幻想，不能写玩法描述"
        },
        "unique_hook": {
          "type": "string", "minLength": 12, "maxLength": 80,
          "description": "一句话解释的独特机制。判据：≤80 字、不含数值加强词、包含一个反常识的因果关系"
        },
        "creative_promise": {
          "type": "string", "minLength": 16,
          "description": "对玩家的承诺：你将会体验到什么别处体验不到的东西"
        },
        "signature_moment": {
          "type": "string", "minLength": 20,
          "description": "标志性时刻。必须包含：发生条件 + 玩家动作 + 感官反馈（至少两种感官）"
        },
        "one_line_pitch": { "type": "string" }
      }
    },
    "gameplay": {
      "type": "object",
      "required": ["genre", "core_mechanic", "supporting_mechanics", "player_decisions", "progression_identity"],
      "additionalProperties": true,
      "properties": {
        "genre": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "core_verb": {
          "type": "string",
          "description": "玩家的核心动作动词（取自 assets/data/creative-patterns/interaction-verbs.json）"
        },
        "core_mechanic": {
          "type": "object",
          "required": ["id", "name", "one_sentence", "why_unique", "non_numeric", "interacts", "changes_decision", "signature_moment"],
          "additionalProperties": true,
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "name": { "type": "string", "minLength": 2 },
            "one_sentence": { "type": "string", "minLength": 8, "maxLength": 80 },
            "why_unique": { "type": "string", "minLength": 12 },
            "non_numeric": {
              "type": "boolean", "const": true,
              "description": "必须是 true —— 只改数值的机制不算独特机制"
            },
            "interacts": {
              "type": "array", "minItems": 2, "uniqueItems": true,
              "items": { "type": "string" },
              "description": "至少与 2 个其他机制产生互动（M2 咬合）"
            },
            "changes_decision": {
              "type": "string", "minLength": 12,
              "description": "它如何改变玩家的最优策略。必须写成「原本会选A，现在要权衡B」"
            },
            "signature_moment": { "type": "string", "minLength": 16 }
          }
        },
        "supporting_mechanics": {
          "type": "array", "minItems": 2, "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "name", "role", "interacts"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "role": { "type": "string", "enum": ["support", "twist", "pressure", "reward"] },
              "interacts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "player_decisions": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["question", "cost"],
            "additionalProperties": true,
            "properties": {
              "question": { "type": "string", "minLength": 8 },
              "cost": { "type": "string", "minLength": 6, "description": "选它的代价" },
              "cadence": { "type": "string", "enum": ["per_second", "per_wave", "per_level", "once"] }
            }
          }
        },
        "progression_identity": {
          "type": "string", "minLength": 12,
          "description": "推进方式的身份。禁止写「更快/更多/更强」，必须是质变（信息变少、规则被改写、代价变高）"
        },
        "fail_state": {
          "type": "string",
          "description": "失败意味着什么（必须能学到东西，或成为玩法的一部分）"
        },
        "win_condition": { "type": "string" }
      }
    },
    "narrative": {
      "type": "object",
      "required": ["world_rules", "theme", "emotional_arc"],
      "additionalProperties": true,
      "properties": {
        "world_rules": {
          "type": "array", "minItems": 3,
          "items": { "type": "string", "minLength": 6 },
          "description": "必须是约束句式：「这个世界的X不能Y」"
        },
        "theme": { "type": "string", "minLength": 4 },
        "emotional_arc": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object",
            "required": ["beat", "emotion"],
            "additionalProperties": true,
            "properties": {
              "beat": { "type": "string" },
              "emotion": { "type": "string" },
              "level": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "story_frame": { "type": "string" },
        "narrative_mechanic_link": {
          "type": "string", "minLength": 12,
          "description": "叙事如何影响规则（不是贴皮）：哪条世界规则被写进了机制"
        }
      }
    },
    "visual": {
      "type": "object",
      "required": ["style_identity", "visual_keywords", "palette", "materials", "lighting", "camera", "shape_language"],
      "additionalProperties": true,
      "properties": {
        "style_identity": {
          "type": "string", "minLength": 10,
          "description": "视觉身份的一句话定义。允许混血（例：水彩绘本 × 微缩纸艺 × 电影级侧光），但不能只写一个流派名"
        },
        "visual_keywords": { "type": "array", "minItems": 5, "items": { "type": "string" } },
        "palette": {
          "type": "object",
          "required": ["primary", "accent", "danger"],
          "additionalProperties": true,
          "properties": {
            "primary": { "type": "array", "minItems": 3, "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
            "accent": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
            "danger": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "ratio": { "type": "object", "description": "各语义色的面积比例，合计应≈1" }
          }
        },
        "materials": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "lighting": { "type": "string", "minLength": 8, "description": "光的方向 + 硬软 + 色温" },
        "camera": { "type": "string", "minLength": 4 },
        "shape_language": { "type": "string", "minLength": 8 },
        "texture_rules": { "type": "array", "items": { "type": "string" } },
        "shadow_rules": { "type": "string" },
        "depth_of_field": { "type": "string" },
        "ui_language": { "type": "string" },
        "typography": { "type": "string" },
        "character_ratio": { "type": "string", "description": "头身比 / 剪影识别度要求" },
        "animation_style": { "type": "string" },
        "fx_style": { "type": "string" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["audio_identity", "music_mood", "instrumentation", "sound_signature", "dynamic_audio_rules"],
      "additionalProperties": true,
      "properties": {
        "audio_identity": {
          "type": "string", "minLength": 10,
          "description": "声音身份的一句话定义（例：木质结构声 + 远处海浪 + 单音钢琴）"
        },
        "music_mood": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "instrumentation": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "sound_signature": {
          "type": "array", "minItems": 2,
          "items": { "type": "string" },
          "description": "只属于这款游戏的声音（例：灯油滴落的三连音）"
        },
        "dynamic_audio_rules": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "required": ["when", "change"],
            "additionalProperties": true,
            "properties": {
              "when": { "type": "string" },
              "change": { "type": "string" }
            }
          }
        },
        "sound_as_gameplay": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "mechanic": { "type": "string" },
            "why": { "type": "string" }
          }
        }
      }
    },
    "experience": {
      "type": "object",
      "required": ["target_emotions", "pacing", "player_memory"],
      "additionalProperties": true,
      "properties": {
        "target_emotions": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["emotion", "weight"],
            "additionalProperties": true,
            "properties": {
              "emotion": { "type": "string" },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "pacing": {
          "type": "array", "minItems": 4,
          "items": {
            "type": "object",
            "required": ["phase", "intensity"],
            "additionalProperties": true,
            "properties": {
              "phase": { "type": "string" },
              "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "player_memory": {
          "type": "string", "minLength": 12,
          "description": "玩家关掉游戏后还记得什么（一句话）"
        },
        "first_10s": { "type": "string", "description": "前 10 秒玩家能理解什么" },
        "first_30s": { "type": "string", "description": "前 30 秒玩家获得什么正反馈" }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_id", "source", "license"],
        "additionalProperties": true,
        "properties": {
          "pattern_id": { "type": "string" },
          "source": { "type": "string" },
          "license": { "type": "string" },
          "how_used": { "type": "string" }
        }
      },
      "description": "引用过的创意模式（必须记录来源与许可，见任务书 §12.5）"
    }
  }
}
