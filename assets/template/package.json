{
  "name": "idea-to-game-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IdeaToGame 生成的 HTML5 小游戏项目（Phaser 3 + Vite + 多平台适配层）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cg": "vite build --mode crazygames --outDir dist/crazygames",
    "build:poki": "vite build --mode poki --outDir dist/poki",
    "build:pg": "vite build --mode playgama --outDir dist/playgama",
    "build:gd": "vite build --mode gamedistribution --outDir dist/gamedistribution",
    "build:all": "npm run build:cg && npm run build:poki && npm run build:pg && npm run build:gd",
    "zip:all": "node scripts/zip-all.mjs",
    "preview:cg": "npx --yes serve dist/crazygames -l 5173"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
