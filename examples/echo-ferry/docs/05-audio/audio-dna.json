        "loop": true,
        "exists": false
      }
    ],
    "states": [
      {
        "id": "exploration",
        "zh": "探索",
        "when": "游戏开始后默认状态；无敌人在 3 格内",
        "stem_gains": {
          "melody": 0.35,
          "rhythm": 0.0,
          "bass": 0.2,
          "percussion": 0.0,
          "atmosphere": 0.5
        },
        "bpm": 68,
        "mode": "major",
        "transition_ms": 1200,
        "note": "稀疏旋律 + 低音乐密度 + 长混响"
      },
      {
        "id": "danger",
        "zh": "危险",
        "when": "有威胁单位进入 5 格内，或玩家资源 < 50%",
        "stem_gains": {
          "melody": 0.25,
          "rhythm": 0.35,
          "bass": 0.7,
          "percussion": 0.1,
          "atmosphere": 0.4
        },
        "bpm": 96,
        "mode": "minor",
        "transition_ms": 1200,
        "note": "低频增强 + 紧张节奏 + 不和谐音程（小二度）"
      },
      {
        "id": "critical",
        "zh": "濒危",
        "when": "玩家资源 ≤20%，或 hull ≤1",
        "stem_gains": {
          "melody": 0.2,
          "rhythm": 0.9,
          "bass": 0.85,
          "percussion": 0.5,
          "atmosphere": 0.15
        },
        "bpm": 140,
        "mode": "minor",
        "transition_ms": 1200,
        "note": "音乐密度增强 + 低频增强 + 环境声衰减到 30%"
      },
      {
        "id": "victory",
        "zh": "胜利",
        "when": "关卡完成 / 送达目标",
        "stem_gains": {
          "melody": 0.85,
          "rhythm": 0.4,
          "bass": 0.5,
          "percussion": 0.55,
          "atmosphere": 0.3
        },
        "bpm": 120,
        "mode": "major",
        "transition_ms": 400,
        "note": "转入胜利主题 + 和声解决 + 独特 stinger"
      }
    ],
    "initial_state": "exploration",
    "victory_stinger": "assets/audio/sfx/feedback_win.mp3",
    "defeat_stinger": "assets/audio/sfx/feedback_defeat.mp3",
    "crossfade_note": "状态切换只改各 stem 的音量，不换曲 —— 这样切换点听不出接缝"
  },
  "sfx": {
    "variants": 3,
    "pitch_jitter_semitones": 1.5,
