      "ui": 0.7,
      "ambience": 0.5
    },
    "distance": {
      "enabled": true,
      "ref_distance": 400,
      "rolloff": 1.2,
      "max_distance": 1600
    },
    "priority_rules": [
      "feedback 层的胜利/失败/受击优先级最高，永不被挤掉",
      "同一事件 100ms 内重复触发只播一次（去重）",
      "并发超过上限时丢弃最旧的低优先级音",
      "已登记音效 22 个（来自 sfx-plan.json）"
    ]
  },
  "emotional_rules": [
    {
      "id": "near_death",
      "when": "玩家资源 ≤20%",
      "change": "环境声 -70%，加入心跳（60→110bpm 随资源下降加速），低频 +6dB",
      "target_state": "critical"
    },
    {
      "id": "safe_zone",
      "when": "玩家进入安全区",
      "change": "心跳 2 秒内淡出，环境声恢复，音乐切 exploration 并降 3dB",
      "target_state": "exploration"
    },
    {
      "id": "reveal",
      "when": "叙事揭示",
      "change": "所有 stem 静音 0.3 秒，只留一个 glass_bell，再整体淡入",
      "target_state": "memory"
    },
    {
      "id": "tension_ramp",
      "when": "危险源接近",
      "change": "rhythm 与 bass 增益随距离线性上升，atmosphere 反向下降",
      "target_state": "danger"
    },
    {
      "id": "silence_before",
      "when": "Boss/高潮前 1.5 秒",
      "change": "全部静音，制造听觉真空",
      "target_state": ""
    },
    {
      "id": "dna_rule_1",
      "when": "敲钟的瞬间",
      "change": "全部 stem 压低 6dB 让回声成为主角，0.6 秒后恢复",
      "target_state": ""
    },
    {
      "id": "dna_rule_2",
      "when": "记忆 ≤1 格",
      "change": "atmosphere 衰减 70%，加入 60→110bpm 的心跳，低频 +6dB",
      "target_state": ""
    },
    {
      "id": "dna_rule_3",
      "when": "黑暗里的东西进入 3 格内",
      "change": "bass 与 rhythm 增益随距离线性上升，atmosphere 反向下降",
      "target_state": ""
    },
    {
      "id": "dna_rule_4",
      "when": "送达灵魂",
      "change": "melody 单独浮出 2 秒，其余全部静音，然后整体淡入",
      "target_state": ""
    }
  ],
  "gameplay_hooks": [
    {
      "event": "echo_ping",
      "audio_role": "回声是唯一的信息来源：方位靠声像，距离靠延迟与音量衰减",
      "visual_fallback": "屏幕边缘的方向指示条（静音玩家必须也能通关）"
    },
    {
      "event": "threat_near",
      "audio_role": "低频脉冲的强度直接对应威胁距离，玩家闭眼也能判断",
      "visual_fallback": "画面边缘向内挤压的暗角"
    }
  ],
