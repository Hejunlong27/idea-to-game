  "identity": {
    "audio_identity": "木质船体吱呀 + 远处海浪 + 单音毡化钢琴；所有声音比画面早半拍出现，让玩家先听见再看见",
    "instrumentation": [
      "wood_creak",
      "sea_waves",
      "felt_piano",
      "sub_pulse",
      "breath"
    ],
    "sound_signature": [
      "敲钟后 0.4 秒的回声三连（三下，间隔递减，暗示距离）",
      "记忆格消耗时的一声木质轻响，音高随剩余记忆下降"
    ],
    "mood_arc": [
      "exploration",
      "danger",
      "critical",
      "victory"
    ]
  },
  "music": {
    "mode": "stems",
    "stems": [
